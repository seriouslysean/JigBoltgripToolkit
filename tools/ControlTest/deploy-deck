#!/usr/bin/env bash
# Copies the throwaway JigBoltgripControlTest addon to the Steam Deck, or removes it with --remove.
#   tools/ControlTest/deploy-deck [--remove] [ssh-host]
set -euo pipefail

remove=0
if [[ ${1:-} == --remove ]]; then
	remove=1
	shift
fi
host=${1:-deck-host}
addons='/home/deck/.local/share/Steam/steamapps/compatdata/4077668031/pfx/drive_c/Program Files (x86)/World of Warcraft/_forever_/Interface/AddOns'
name=JigBoltgripControlTest
here=$(cd "$(dirname "$0")" && pwd)
ssh_opts="ssh -o BatchMode=yes -o ConnectTimeout=8"

if ((remove)); then
	$ssh_opts "$host" "rm -rf \"$addons/$name\""
	echo "removed $name from $host"
else
	rsync -a --delete --exclude='.*' -e "$ssh_opts" "$here/$name/" "$host:$addons/$name/"
	echo "deployed $name to $host"
fi
