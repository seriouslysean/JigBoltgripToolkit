#!/usr/bin/env bash
# Every check of the library, in one command; the pre-push hook and CI run it. One line per step with
# its seconds; a failed step shows its output; the exit is nonzero if any failed.
# The step runner calls each check function by name.
# shellcheck disable=SC2329
set -uo pipefail
# luarocks --local installs luacheck and busted here, which a login shell does not put on PATH.
[[ -d $HOME/.luarocks/bin ]] && PATH="$HOME/.luarocks/bin:$PATH"

failed=0
step() {
	local name=$1 started output
	shift
	started=$SECONDS
	if output=$("$@" 2>&1); then
		printf 'ok   %s (%d s)\n' "$name" $((SECONDS - started))
	else
		printf 'FAIL %s (%d s)\n%s\n' "$name" $((SECONDS - started)) "$output"
		failed=1
	fi
}

# The client runs Lua 5.1; LuaJIT reads 5.1, where a current luac accepts syntax the client rejects.
syntax() {
	local file
	for file in $(git ls-files '*.lua'); do luajit -bl "$file" >/dev/null || return 1; done
}
# Docs and comments in one voice (docs/standards.md, Ethos 7).
voice() { git ls-files -z '*.md' '*.lua' | xargs -0 luajit tests/conformance.lua --voice; }
shell() { shellcheck scripts/check tests/module-check.sh tools/new-module.sh && shfmt -d scripts/check tests/module-check.sh tools/new-module.sh; }

step "syntax (Lua 5.1)" syntax
step "shell (ShellCheck, shfmt)" shell
step "luacheck" luacheck . -q
step "comments" luajit tests/conformance.lua --comments JigBoltgripToolkit.lua
step "voice" voice
step "specs" busted

exit $failed
