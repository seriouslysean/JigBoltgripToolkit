#!/usr/bin/env bash
# Every check of the library, in one command; the pre-push hook and CI run it. One line per step with
# its seconds; a failed step shows its output; the exit is nonzero if any failed.
# The step runner calls each check function by name.
# shellcheck disable=SC2329
# shellcheck source=tests/check-steps.sh
source tests/check-steps.sh

syntax() { git ls-files -z '*.lua' | xargs -0 "$luac" -p; }
# Docs and comments, shell comments included, in one voice, citing no other addon (docs/standards.md, Ethos 7 and 8).
voice() { git ls-files -z '*.md' '*.lua' '*.toc' '*.yml' .luacheckrc .pkgmeta 'skeleton/.pkgmeta' '*.sh' 'scripts/*' 'skeleton/scripts/*' '.githooks/*' 'tools/*' | xargs -0 "$lua" tests/conformance.lua --voice; }
shells=(scripts/check tests/module-check.sh tests/check-steps.sh tests/deploy-deck.sh tools/new-module.sh tools/setup-lua.sh tools/review-collect.sh tools/client-audit.sh tools/perf-deck skeleton/scripts/check skeleton/scripts/deploy-deck)
shell() { shellcheck "${shells[@]}" && shfmt -d "${shells[@]}"; }

step "syntax (Lua 5.1)" syntax
step "shell (ShellCheck, shfmt)" shell
step "file modes" modes
step "luacheck" luacheck . -q
step "comments" "$lua" tests/conformance.lua --comments JigBoltgripToolkit.lua
step "voice" voice
step "specs" busted --lua="$lua"

exit $failed
