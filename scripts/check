#!/usr/bin/env bash
# Every check of the library, in one command; the pre-push hook and CI run it. One line per step with
# its seconds; a failed step shows its output; the exit is nonzero if any failed.
# The step runner calls each check function by name.
# shellcheck disable=SC2329
set -uo pipefail
# The client's Lua is PUC Lua 5.1, and so is CI's; tools/setup-lua.sh builds it here with CI's busted and
# luacheck. LuaJIT differs where it matters (string.format takes nil for %s), so nothing else runs a check.
[[ -d $HOME/.local/share/lua51/bin ]] && PATH="$HOME/.local/share/lua51/bin:$PATH"
lua=$(command -v lua5.1 || command -v lua || true)
luac=$(command -v luac5.1 || command -v luac || true)
lua51() { [[ -n $lua && -n $luac ]] && "$lua" -e 'assert(_VERSION == "Lua 5.1" and not jit)' 2>/dev/null && [[ $("$luac" -v 2>&1) == "Lua 5.1"* ]]; }
if ! lua51; then
	echo "The checks need PUC Lua 5.1 (the client's): run tools/setup-lua.sh from the toolkit repository." >&2
	exit 1
fi

failed=0
step() {
	local name=$1 started output
	shift
	started=$SECONDS
	if output=$("$@" 2>&1); then
		printf 'ok   %s (%d s)\n' "$name" $((SECONDS - started))
	else
		printf 'FAIL %s (%d s)\n%s\n' "$name" $((SECONDS - started)) "$output"
		failed=1
	fi
}

syntax() { git ls-files -z '*.lua' | xargs -0 "$luac" -p; }
# Docs and comments in one voice (docs/standards.md, Ethos 7).
voice() { git ls-files -z '*.md' '*.lua' | xargs -0 "$lua" tests/conformance.lua --voice; }
shell() { shellcheck scripts/check tests/module-check.sh tools/new-module.sh tools/setup-lua.sh tools/review-collect.sh && shfmt -d scripts/check tests/module-check.sh tools/new-module.sh tools/setup-lua.sh tools/review-collect.sh; }

step "syntax (Lua 5.1)" syntax
step "shell (ShellCheck, shfmt)" shell
step "luacheck" luacheck . -q
step "comments" "$lua" tests/conformance.lua --comments JigBoltgripToolkit.lua
step "voice" voice
step "specs" busted --lua="$lua"

exit $failed
